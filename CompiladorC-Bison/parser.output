Terminales no usados en la gramática

    INCLUDE
    DEFINE
    ERROR
    MULVAR


Gramática

    0 $accept: statement_list $end

    1 statement_list: statement
    2               | statement_list statement

    3 statement: declaration_list PUNTOCOMA
    4          | declaration_init_list PUNTOCOMA
    5          | tipo_data defFunc
    6          | VOID defFunc
    7          | tipo_data defFunc PUNTOCOMA
    8          | VOID defFunc PUNTOCOMA
    9          | condicional_exp
   10          | iterador_exp
   11          | res_tokens PUNTOCOMA
   12          | etiqueta_statement
   13          | block_stmt

   14 res_tokens: RETURN
   15           | RETURN expression
   16           | CONTINUE
   17           | BREAK
   18           | GOTO ID

   19 primary_expression: id_arr
   20                   | error
   21                   | preSufix_expr
   22                   | callFunc
   23                   | ENTERO
   24                   | DIGITO
   25                   | CARACTER
   26                   | PAREN_A expression PAREN_C

   27 expression: primary_expression
   28           | expression op primary_expression
   29           | expression op_bool primary_expression
   30           | PAREN_A expression INTERROGACION expression DOSPUNTOS expression PAREN_C

   31 op: SUMA
   32   | RESTA
   33   | MUL
   34   | DIV
   35   | MOD

   36 preSufix_expr: preSufix_cicle id_side
   37              | preSufix_cicle id_arr
   38              | id_side

   39 id_side: id_arr op_inc_dec
   40        | op_inc_dec id_arr
   41        | op_inc_dec error
   42        | error op_inc_dec

   43 preSufix_cicle: preSufix_op
   44               | preSufix_cicle preSufix_op

   45 id_arr: ID
   46       | id_arr SPAREN_A expr_option SPAREN_C
   47       | id_arr SPAREN_A SPAREN_C
   48       | error SPAREN_A SPAREN_C
   49       | error SPAREN_A expr_option SPAREN_C

   50 op_inc_dec: INC
   51           | DEC

   52 preSufix_op: SUMA
   53            | RESTA
   54            | NOT

   55 declaration_init_list: tipo_data declaration_init_listP
   56                      | tipo_data

   57 declaration_init_listP: asign_cicle
   58                       | id_arr
   59                       | declaration_init_listP COMA asign_cicle
   60                       | declaration_init_listP COMA id_arr

   61 declaration_list: expression_list
   62                 | asign_list

   63 expression_list: expr_option
   64                | declaration_list COMA expr_option

   65 expr_option: expression
   66            | expression INTERROGACION asign_ciclep DOSPUNTOS asign_ciclep

   67 asign_list: asign_cicle
   68           | declaration_list COMA asign_cicle

   69 asign_cicle: id_arr asign_op asign_ciclep
   70            | error asign_op asign_ciclep
   71            | id_arr error asign_ciclep

   72 asign_ciclep: expr_option
   73             | asign_cicle

   74 asign_op: ASIGNACION
   75         | SUMAVAR
   76         | RESTAVAR
   77         | MODVAR
   78         | DIVVAR

   79 tipo_data: INT
   80          | CHAR

   81 condicional_exp: IF PAREN_A ite_cond_options PAREN_C statement
   82                | IF PAREN_A ite_cond_options PAREN_C statement ELSE statement
   83                | SWITCH PAREN_A expr_option PAREN_C statement

   84 iterador_exp: WHILE PAREN_A ite_cond_options PAREN_C statement
   85             | FOR PAREN_A for_option PUNTOCOMA ite_cond_options PUNTOCOMA ite_cond_options PAREN_C statement
   86             | DO statement_list WHILE PAREN_A ite_cond_options PAREN_C PUNTOCOMA

   87 for_option: tipo_data asign_cicle
   88           | tipo_data error
   89           | expr_option
   90           | asign_cicle

   91 ite_cond_options: expr_option
   92                 | asign_cicle

   93 op_bool: IGUAL
   94        | DIF
   95        | MAYOR
   96        | MENOR
   97        | MAYORIGUAL
   98        | MENORIGUAL
   99        | AND
  100        | OR

  101 defFunc: ID PAREN_A param_list PAREN_C PUNTOCOMA
  102        | ID PAREN_A param_list PAREN_C block_stmt
  103        | ID PAREN_A PAREN_C PUNTOCOMA
  104        | ID PAREN_A PAREN_C block_stmt
  105        | error block_stmt
  106        | ID PAREN_A PAREN_C error
  107        | ID PAREN_A error PAREN_C block_stmt
  108        | error PAREN_A PAREN_C block_stmt

  109 param_list: param_tipo
  110           | param_list COMA param_tipo
  111           | param_list COMA error
  112           | error COMA param_tipo

  113 param_tipo: tipo_data id_arr
  114           | tipo_data
  115           | tipo_data error

  116 callFunc: ID PAREN_A arg_list PAREN_C
  117         | ID PAREN_A PAREN_C
  118         | error PAREN_A arg_list PAREN_C
  119         | error PAREN_A PAREN_C

  120 arg_list: expr_option
  121         | arg_list COMA expr_option

  122 etiqueta_statement: CASE expr_option DOSPUNTOS statement
  123                   | DEFAULT DOSPUNTOS statement
  124                   | ID DOSPUNTOS statement
  125                   | DEFAULT error
  126                   | error DOSPUNTOS

  127 block_stmt: CORCH_A statement_list CORCH_C
  128           | CORCH_A CORCH_C
  129           | CORCH_A error CORCH_C


